@model KLENZ.Models.SalesEnquiry
@inject KLENZ.Data.KLENZDbContext Db
@{
    // Suggest the statuses already set up in the Status table. Typing a different one still works.
    var statusOptions = new List<string>();
    try
    {
        statusOptions = Db.Status.Select(x => x.FullName).ToList();
    }
    catch
    {
        // Suggestions are optional: the form works without them.
    }
}

@{
    ViewData["Title"] = "New sales enquiry";
}
