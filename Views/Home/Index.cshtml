@model KLENZ.Models.DashboardViewModel

@{
    ViewData["Title"] = "Overview";
    var attention = Model.Overdue.Count + Model.DueToday.Count;
    var firstTab = Model.Overdue.Count > 0 && Model.DueToday.Count == 0 ? "over" : "today";
}

@functions {
    // Indian number style: lakh and crore
    static string Inr(decimal value)
    {
        var abs = Math.Abs(value);
        if (abs >= 10000000m) { return "₹" + (value / 10000000m).ToString("0.##") + " Cr"; }
        if (abs >= 100000m) { return "₹" + (value / 100000m).ToString("0.##") + " L"; }
        return "₹" + value.ToString("N0");
    }

    static string Rate(int part, int whole)
    {
        return whole <= 0 ? "0%" : Math.Round(part * 100.0 / whole) + "%";
    }
}

<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Overview</h1>
            @if (Model.HasFinancialYear)
            {
                <p class="page-sub">Financial year @Model.FinancialYear · @Model.StartDate.ToString("d MMM yyyy") to @Model.EndDate.ToString("d MMM yyyy")</p>
            }
        </div>
    </div>
    <div class="page-actions">
        <a asp-controller="QuotationReports" asp-action="Create" class="btn"><i class="bi bi-file-earmark-plus"></i><span>New quotation</span></a>
        <a asp-controller="SalesEnquiries" asp-action="Create" class="btn btn-primary" data-primary-action><i class="bi bi-plus-lg"></i><span>New enquiry</span></a>
    </div>
</div>

@if (!Model.HasFinancialYear)
{
    <div class="notice" role="status">
        <i class="bi bi-calendar2-range"></i>
        <div>
            <strong>No active financial year</strong>
            <p>Mark a financial year as active to see numbers here. <a asp-controller="FinancialYears" asp-action="Index">Open financial years</a></p>
        </div>
    </div>
}
else
{
    <div class="grid">
        <a class="card kpi g3" asp-controller="SalesEnquiries" asp-action="Index">
            <div class="lab">Enquiries <i class="bi bi-chat-left-text"></i></div>
            <div class="val num">@Model.Enquiries</div>
            <div class="sub">@(attention == 0 ? "No follow-ups due" : attention + (attention == 1 ? " follow-up needs attention" : " follow-ups need attention"))</div>
        </a>
        <a class="card kpi g3" asp-controller="QuotationReports" asp-action="Index">
            <div class="lab">Quoted value <i class="bi bi-file-earmark-text"></i></div>
            <div class="val num">@Inr(Model.QuotedValue)</div>
            <div class="sub">@Model.Quotations @(Model.Quotations == 1 ? "quotation" : "quotations")</div>
        </a>
        <a class="card kpi g3" asp-controller="ProjectLists" asp-action="Index">
            <div class="lab">Work orders <i class="bi bi-clipboard-check"></i></div>
            <div class="val num">@Inr(Model.WonValue)</div>
            <div class="sub">@Model.Projects @(Model.Projects == 1 ? "project" : "projects") · @Rate(Model.Projects, Model.Enquiries) of enquiries</div>
        </a>
        <a class="card kpi g3" asp-controller="ProjectTenderList" asp-action="Index">
            <div class="lab">Tenders <i class="bi bi-file-ruled"></i></div>
            <div class="val num">@Model.Tenders</div>
            <div class="sub">@Model.UpcomingTenders to be tendered · @Model.Consultancy consultancy</div>
        </a>

        <section class="card g5" aria-labelledby="funnelTitle">
            <div class="card-head"><h3 id="funnelTitle">Sales funnel</h3><small>This financial year</small></div>
            <div class="funnel" id="funnel"
                 data-stages='[["Enquiries",@Model.Enquiries],["Quotations",@Model.Quotations],["Positive",@Model.Positive],["Projects",@Model.Projects]]'></div>
        </section>

        <section class="card g7" aria-labelledby="chartTitle">
            <div class="card-head">
                <h3 id="chartTitle">Quoted and won by month</h3><small>Rupees in lakh</small>
                <div class="sp legend"><span><i style="background:var(--accent)"></i>Quoted</span><span><i style="background:var(--line-2)"></i>Won</span></div>
            </div>
            <div class="chart" id="chart"></div>
        </section>

        <section class="card g5" aria-labelledby="attTitle">
            <div class="card-head"><h3 id="attTitle">Follow-ups</h3><div class="sp"><a class="link" asp-controller="SalesEnquiries" asp-action="Index">All enquiries</a></div></div>
            <div class="tabs" id="attTabs">
                <button type="button" class="warn @(firstTab == "over" ? "on" : "")" data-tab="over">Overdue<b>@Model.Overdue.Count</b></button>
                <button type="button" class="@(firstTab == "today" ? "on" : "")" data-tab="today">Today<b>@Model.DueToday.Count</b></button>
                <button type="button" data-tab="soon">Next 7 days<b>@Model.Upcoming.Count</b></button>
            </div>

            <div class="rows" data-panel="over" hidden="@(firstTab != "over")">
                @foreach (var r in Model.Overdue)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when over">@r.Date.ToString("dd MMM")</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Place @(r.Place != "" && r.Details != "" ? "·" : "") @r.Details</small></div>
                        <i class="bi bi-chevron-right" style="color:var(--faint)"></i>
                    </a>
                }
                @if (Model.Overdue.Count == 0)
                {
                    <div class="empty"><i class="bi bi-check2-circle"></i>Nothing overdue.</div>
                }
            </div>
            <div class="rows" data-panel="today" hidden="@(firstTab != "today")">
                @foreach (var r in Model.DueToday)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when today">Today</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Place @(r.Place != "" && r.Details != "" ? "·" : "") @r.Details</small></div>
                        <i class="bi bi-chevron-right" style="color:var(--faint)"></i>
                    </a>
                }
                @if (Model.DueToday.Count == 0)
                {
                    <div class="empty"><i class="bi bi-check2-circle"></i>No follow-ups due today.</div>
                }
            </div>
            <div class="rows" data-panel="soon" hidden>
                @foreach (var r in Model.Upcoming)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when">@r.Date.ToString("ddd dd")</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Place @(r.Place != "" && r.Details != "" ? "·" : "") @r.Details</small></div>
                        <i class="bi bi-chevron-right" style="color:var(--faint)"></i>
                    </a>
                }
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="empty"><i class="bi bi-calendar3"></i>Nothing scheduled for the next 7 days.</div>
                }
            </div>
        </section>

        <section class="card g7" aria-labelledby="recentTitle">
            <div class="card-head"><h3 id="recentTitle">Recent enquiries</h3><div class="sp"><a class="link" asp-controller="SalesEnquiries" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var e in Model.RecentEnquiries)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@e.Id">
                        <span class="av">@(e.Title.Length > 1 ? e.Title.Substring(0, 2).ToUpper() : e.Title.ToUpper())</span>
                        <div class="t"><strong>@e.Title</strong><small>@e.Subtitle</small></div>
                        @if (e.Status != "")
                        {
                            <span class="pill pill-gray" data-status-pill>@e.Status</span>
                        }
                        <span class="when">@(e.Date.HasValue ? e.Date.Value.ToString("dd MMM") : "No date")</span>
                    </a>
                }
                @if (Model.RecentEnquiries.Count == 0)
                {
                    <div class="empty"><i class="bi bi-chat-left-text"></i>No enquiries yet this year. Add the first one.</div>
                }
            </div>
        </section>

        <section class="card g6" aria-labelledby="projTitle">
            <div class="card-head"><h3 id="projTitle">Latest work orders</h3><div class="sp"><a class="link" asp-controller="ProjectLists" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var p in Model.RecentProjects)
                {
                    <a asp-controller="ProjectLists" asp-action="Details" asp-route-id="@p.Id">
                        <div class="t"><strong>@p.Title</strong><small>@p.Subtitle</small></div>
                        <span class="amt num">@(p.Amount.HasValue ? Inr(p.Amount.Value) : "")</span>
                    </a>
                }
                @if (Model.RecentProjects.Count == 0)
                {
                    <div class="empty"><i class="bi bi-clipboard-check"></i>No work orders logged yet.</div>
                }
            </div>
        </section>

        <section class="card g6" aria-labelledby="tenderTitle">
            <div class="card-head"><h3 id="tenderTitle">Latest tenders</h3><div class="sp"><a class="link" asp-controller="ProjectTenderList" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var t in Model.RecentTenders)
                {
                    <a asp-controller="ProjectTenderList" asp-action="Details" asp-route-id="@t.Id">
                        <div class="t"><strong>@t.Title</strong><small>@t.Subtitle</small></div>
                        <span class="amt num">@(t.Amount.HasValue ? Inr(t.Amount.Value) : "")</span>
                    </a>
                }
                @if (Model.RecentTenders.Count == 0)
                {
                    <div class="empty"><i class="bi bi-file-ruled"></i>No tenders logged yet.</div>
                }
            </div>
        </section>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var months = @Html.Raw(Json.Serialize(Model.Months));

            // Follow-up tabs
            var tabs = document.getElementById('attTabs');
            if (tabs) {
                tabs.addEventListener('click', function (e) {
                    var b = e.target.closest('button');
                    if (!b) { return; }
                    tabs.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
                    document.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== b.getAttribute('data-tab'); });
                });
            }

            // Status colours on recent enquiries
            document.querySelectorAll('[data-status-pill]').forEach(function (p) {
                var t = p.textContent.toLowerCase(), tone = 'gray';
                if (/positive|won|approved|confirm|complete|order/.test(t)) { tone = 'green'; }
                else if (/lost|reject|cancel|closed|dropped/.test(t)) { tone = 'red'; }
                else if (/follow|pending|wait|hold|progress/.test(t)) { tone = 'amber'; }
                else if (/quot|sent|submitted|offer/.test(t)) { tone = 'violet'; }
                else if (/new|open|enquir|received/.test(t)) { tone = 'blue'; }
                p.className = 'pill pill-' + tone;
            });

            // Funnel
            var funnel = document.getElementById('funnel');
            if (funnel) {
                var stages = JSON.parse(funnel.getAttribute('data-stages')), top = Math.max.apply(null, stages.map(function (s) { return s[1]; })) || 1;
                funnel.innerHTML = stages.map(function (s, i) {
                    var next = stages[i + 1], step = !next ? '' : s[1] <= 0 ? 'No data yet' : next[1] > s[1] ? 'More recorded at the next stage' : Math.round(next[1] / s[1] * 100) + '% move forward';
                    return '<div class="fr"><b>' + s[0] + '</b><div class="ft"><div class="ff" data-w="' + (s[1] / top * 100) + '" style="opacity:' + (1 - i * 0.17) + '"></div></div><span class="n num">' + s[1] + '</span></div>' +
                        (next ? '<div class="fr"><div class="fc">' + step + '</div></div>' : '');
                }).join('');
                setTimeout(function () {
                    funnel.querySelectorAll('.ff').forEach(function (el) { el.style.width = el.getAttribute('data-w') + '%'; });
                }, 60);
            }

            // Quoted and won by month
            var chart = document.getElementById('chart');
            if (chart) {
                if (!months.length || !months.some(function (m) { return m.quoted > 0 || m.won > 0; })) {
                    chart.innerHTML = '<div class="empty"><i class="bi bi-bar-chart-line"></i>No quotations or work orders with dates yet this year.</div>';
                    return;
                }
                var lakh = function (v) { return v / 100000; };
                var peak = Math.max.apply(null, months.map(function (m) { return Math.max(lakh(m.quoted), lakh(m.won)); }));
                var pow = Math.pow(10, Math.floor(Math.log10(peak || 1))), max = Math.ceil(peak / pow) * pow || 1;
                if (max / pow <= 2) { max = Math.ceil(peak / (pow / 2)) * (pow / 2); }
                var H = 190, L = 42, W = 560, bw = (W - L) / months.length, bar = Math.min(16, bw / 2 - 3);
                var fmt = function (v) { return v >= 100 ? Math.round(v) : Math.round(v * 10) / 10; };
                var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 26) + '" role="img" aria-label="Quoted and won value by month">';
                [0, 0.25, 0.5, 0.75, 1].forEach(function (f) {
                    var y = H - f * (H - 10);
                    svg += '<line x1="' + L + '" x2="' + W + '" y1="' + y + '" y2="' + y + '" stroke="var(--line)" stroke-width="1"/>' +
                        '<text x="' + (L - 8) + '" y="' + (y + 4) + '" text-anchor="end" font-size="11" fill="var(--faint)">' + fmt(max * f) + '</text>';
                });
                months.forEach(function (m, i) {
                    var x = L + i * bw + bw / 2, hq = lakh(m.quoted) / max * (H - 10), hw = lakh(m.won) / max * (H - 10);
                    svg += '<rect x="' + (x - bar - 1) + '" y="' + (H - hq) + '" width="' + bar + '" height="' + hq + '" rx="3" fill="var(--accent)"><title>' + m.label + ': quoted ₹' + fmt(lakh(m.quoted)) + ' L</title></rect>' +
                        '<rect x="' + (x + 1) + '" y="' + (H - hw) + '" width="' + bar + '" height="' + hw + '" rx="3" fill="var(--line-2)"><title>' + m.label + ': won ₹' + fmt(lakh(m.won)) + ' L</title></rect>' +
                        '<text x="' + x + '" y="' + (H + 18) + '" text-anchor="middle" font-size="11.5" fill="var(--muted)">' + m.label + '</text>';
                });
                chart.innerHTML = svg + '</svg>';
            }
        })();
    </script>
}
