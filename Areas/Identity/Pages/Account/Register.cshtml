@page
@model RegisterModel
@{
    ViewData["Title"] = Model.CreatingForSomeoneElse ? "New user" : "Create account";
}

@if (Model.CreatingForSomeoneElse)
{
    <a asp-area="" asp-controller="Users" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Back to users</a>
}

<div class="auth-card">
    @if (!Model.CreatingForSomeoneElse)
    {
        <div class="auth-brand"><span class="logo">K</span>KLENZ</div>
    }
    <h1>@(Model.CreatingForSomeoneElse ? "New user" : "Create the first account")</h1>
    <p class="lead">
        @(Model.CreatingForSomeoneElse
            ? "Create a sign-in for a colleague, then share the password with them privately."
            : "This account becomes the administrator and can add everyone else.")
    </p>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="auth-field">
            <label asp-for="Input.UserName">Username</label>
            <input asp-for="Input.UserName" class="form-control" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" required />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.Email">Email (optional)</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="off" placeholder="name@company.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" id="registerPassword" type="password" class="form-control" autocomplete="new-password" required />
            <button type="button" class="toggle-pwd" data-toggle-pwd="registerPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" id="confirmPassword" type="password" class="form-control" autocomplete="new-password" required />
            <button type="button" class="toggle-pwd" data-toggle-pwd="confirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <p class="auth-help" style="text-align:left;margin:0 0 12px">At least 8 characters, with upper and lower case letters, a number and a symbol.</p>

        <button id="registerSubmit" type="submit" class="btn btn-primary">@(Model.CreatingForSomeoneElse ? "Create user" : "Create account")</button>
    </form>

    @if (!Model.CreatingForSomeoneElse)
    {
        <p class="auth-help">Already have an account? <a asp-page="./Login">Sign in</a></p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-toggle-pwd]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-toggle-pwd'));
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.innerHTML = '<i class="bi bi-eye' + (show ? '-slash' : '') + '"></i>';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        });
    </script>
}
