@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Delete financial year";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to financial years</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Delete financial year</h1>
        </div>
    </div>
</div>

<div class="card detail-card">
    <div class="card-body p-4">
        <p class="notice notice-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Are you sure you want to delete this Financial Year?</p><dl class="facts">
            <div class="fact"><dt>Start Date</dt><dd>@Model.StartDate.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>End Date</dt><dd>@Model.EndDate.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>Financial Year</dt><dd><strong>@Model.FyYear</strong></dd></div>

            <div class="fact"><dt>Status</dt><dd>@(Model.IsActive == 1 ? "Active" : "Inactive")</dd></div>
        </dl>
        
        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Cancel</a>
        </form>
    </div>
</div>
