@model KLENZ.Models.ProjectList

@{
    ViewData["Title"] = "Project details";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to project list</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Project details</h1>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
    </div>
</div>

<div class="card detail-card">

    <div class="card-body">
        <dl class="facts">
            <div class="fact"><dt><i class="bi bi-calendar"></i> @Html.DisplayNameFor(model => model.WorkOrderDate)</dt><dd>@Html.DisplayFor(model => model.WorkOrderDate)</dd></div>

            <div class="fact"><dt><i class="bi bi-buildings"></i> @Html.DisplayNameFor(model => model.CompanyNameStr)</dt><dd>@Html.DisplayFor(model => model.CompanyNameStr)</dd></div>

            <div class="fact"><dt><i class="bi bi-person"></i> @Html.DisplayNameFor(model => model.CustomerDetails)</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt><i class="bi bi-list-task"></i> @Html.DisplayNameFor(model => model.WorkDetails)</dt><dd>@Html.DisplayFor(model => model.WorkDetails)</dd></div>

            <div class="fact"><dt><i class="bi bi-cash-stack"></i> @Html.DisplayNameFor(model => model.WorkOrderValue)</dt><dd>@Html.DisplayFor(model => model.WorkOrderValue)</dd></div>

            <div class="fact"><dt><i class="bi bi-chat-left-text"></i> @Html.DisplayNameFor(model => model.Remarks)</dt><dd>@Html.DisplayFor(model => model.Remarks)</dd></div>

            <div class="fact"><dt><i class="bi bi-clock-history"></i> @Html.DisplayNameFor(model => model.CreatedDateTime)</dt><dd>@Html.DisplayFor(model => model.CreatedDateTime)</dd></div>

            <div class="fact"><dt><i class="bi bi-person-badge"></i> @Html.DisplayNameFor(model => model.CreatedUserName)</dt><dd>@Html.DisplayFor(model => model.CreatedUserName)</dd></div>

            <div class="fact"><dt><i class="bi bi-calendar-event"></i> @Html.DisplayNameFor(model => model.FinancialYearStr)</dt><dd>@Html.DisplayFor(model => model.FinancialYearStr)</dd></div>
        </dl>
</div>
