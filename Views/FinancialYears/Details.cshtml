@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Financial year details";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to financial years</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Financial year details</h1>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
    </div>
</div>

<div class="card detail-card">
    <div class="card-body p-4">
        <dl class="facts">
            <div class="fact"><dt>Start Date</dt><dd>@Model.StartDate.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>End Date</dt><dd>@Model.EndDate.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>Financial Year</dt><dd><strong>@Model.FyYear</strong></dd></div>

            <div class="fact"><dt>Status</dt><dd>@if (Model.IsActive == 1)
                {
                    <span class="badge bg-success px-3 py-2">Active financial year @Model.FyYear</span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2">Inactive</span>
                }</dd></div>

            <div class="fact"><dt>Created Date</dt><dd>@Model.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</dd></div>
        </dl>
    </div>
</div>
