@model KLENZ.Models.SalesEnquiry

@{
    ViewData["Title"] = "Sales enquiry details";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to enquiries</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Sales enquiry details</h1>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
    </div>
</div>

<div class="card detail-card">
    <div class="card-body">
        <dl class="facts">
            <div class="fact"><dt>Company Name</dt><dd>@Html.DisplayFor(model => model.CompanyNameStr)</dd></div>

            <div class="fact"><dt>Referred By</dt><dd>@Html.DisplayFor(model => model.ReferedBy)</dd></div>

            <div class="fact"><dt>Enquiry Details</dt><dd>@Html.DisplayFor(model => model.EnquiryDetails)</dd></div>

            <div class="fact"><dt>Enquiry Date</dt><dd>@Model.EnquiryDate?.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>Customer Details</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt>Status</dt><dd>@Html.DisplayFor(model => model.Status)</dd></div>

            <div class="fact"><dt>Remarks</dt><dd>@Html.DisplayFor(model => model.Remarks)</dd></div>

            <div class="fact"><dt>Reminder Date</dt><dd>@Model.ReminderDate?.ToShortDateString()</dd></div>

            <div class="fact"><dt>Reminder Place</dt><dd>@Html.DisplayFor(model => model.ReminderPlace)</dd></div>

            <div class="fact"><dt>Created Date & Time</dt><dd>@(Model.CreatedDateTime.HasValue ? Model.CreatedDateTime.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</dd></div>

            <div class="fact"><dt>Created By</dt><dd>@Model.CreatedUserName</dd></div>
        </dl>
    </div>
</div>
