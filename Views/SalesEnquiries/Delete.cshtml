@model KLENZ.Models.SalesEnquiry

@{
    ViewData["Title"] = "Delete sales enquiry";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to enquiries</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Delete sales enquiry</h1>
        </div>
    </div>
</div>

<div class="card detail-card">
    <div class="card-body">
        <p class="notice notice-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Are you sure you want to delete this record?</p>

        <!-- Bootstrap Grid for Displaying Fields -->
        <dl class="facts">
            <div class="fact"><dt>Company Name</dt><dd>@Html.DisplayFor(model => model.CompanyNameStr)</dd></div>

            <div class="fact"><dt>Referred By</dt><dd>@Html.DisplayFor(model => model.ReferedBy)</dd></div>

            <div class="fact"><dt>Enquiry Details</dt><dd>@Html.DisplayFor(model => model.EnquiryDetails)</dd></div>

            <div class="fact"><dt>Enquiry Date</dt><dd>@Html.DisplayFor(model => model.EnquiryDate)</dd></div>

            <div class="fact"><dt>Customer Details</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt>Status</dt><dd>@Html.DisplayFor(model => model.Status)</dd></div>

            <div class="fact"><dt>Remarks</dt><dd>@Html.DisplayFor(model => model.Remarks)</dd></div>

            <div class="fact"><dt>Reminder Date</dt><dd>@Html.DisplayFor(model => model.ReminderDate)</dd></div>

            <div class="fact"><dt>Reminder Place</dt><dd>@Html.DisplayFor(model => model.ReminderPlace)</dd></div>
        </dl>

        <!-- Buttons with proper spacing -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-cols">
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            </div>
        </form>
    </div>
</div>
