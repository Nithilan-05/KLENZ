@model KLENZ.Models.QuotationReport

@{
    ViewData["Title"] = "Edit quotation";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to quotations</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Edit quotation</h1>
        </div>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-cols">
                <div class="form-col">
                    <div class="mb-3">
                        <label asp-for="QuotationDate" class="fw-bold"></label>
                        <input asp-for="QuotationDate" type="date" class="form-control" />
                        <span asp-validation-for="QuotationDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompanyNameId" class="fw-bold"></label>
                        <select asp-for="CompanyNameId" class="form-control" asp-items="ViewBag.Companies">
                            <option value="">-- Select Company --</option>
                        </select>
                        <span asp-validation-for="CompanyNameId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ProductDetails" class="fw-bold"></label>
                        <input asp-for="ProductDetails" class="form-control" />
                        <span asp-validation-for="ProductDetails" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CustomerDetails" class="fw-bold"></label>
                        <input asp-for="CustomerDetails" class="form-control" />
                        <span asp-validation-for="CustomerDetails" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-col">
                    <div class="mb-3">
                        <label asp-for="QuotationValue" class="fw-bold"></label>
                        <input asp-for="QuotationValue" class="form-control" type="number" step="0.01" min="0" max="9999999999999999.99" />
                        <span asp-validation-for="QuotationValue" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-check-label fw-bold">
                            <input type="checkbox" class="form-check-input" id="IsPositive" name="IsPositive" value="1" @(Model?.IsPositive == 1 ? "checked" : "") />
                            Is Positive Response
                        </label>
                        <span asp-validation-for="IsPositive" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Remarks" class="fw-bold"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
