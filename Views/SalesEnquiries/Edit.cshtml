@model KLENZ.Models.SalesEnquiry
@inject KLENZ.Data.KLENZDbContext Db
@{
    // Suggest the statuses already set up in the Status table. Typing a different one still works.
    var statusOptions = new List<string>();
    try
    {
        statusOptions = Db.Status.Select(x => x.FullName).ToList();
    }
    catch
    {
        // Suggestions are optional: the form works without them.
    }
}

@{
    ViewData["Title"] = "Edit sales enquiry";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to enquiries</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Edit sales enquiry</h1>
        </div>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <!-- Left Column -->
                <div class="form-col">
                    <div class="mb-3">
                        <label asp-for="CompanyNameId" class="fw-bold"></label>
                        <select asp-for="CompanyNameId" class="form-control" asp-items="ViewBag.Companies">
                            <option value="">-- Select Company --</option>
                        </select>
                        <span asp-validation-for="CompanyNameId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReferedBy" class="fw-bold"></label>
                        <input asp-for="ReferedBy" class="form-control" />
                        <span asp-validation-for="ReferedBy" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EnquiryDetails" class="fw-bold"></label>
                        <input asp-for="EnquiryDetails" class="form-control" />
                        <span asp-validation-for="EnquiryDetails" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EnquiryDate" class="fw-bold"></label>
                        <input asp-for="EnquiryDate" type="date" class="form-control" />
                        <span asp-validation-for="EnquiryDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerDetails" class="fw-bold"></label>
                        <input asp-for="CustomerDetails" class="form-control" />
                        <span asp-validation-for="CustomerDetails" class="text-danger"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="form-col">
                    <div class="mb-3">
                        <label asp-for="Status" class="fw-bold"></label>
                        <input asp-for="Status" autocomplete="off" class="form-control" list="statusOptions" placeholder="Choose or type a status" />
                        <datalist id="statusOptions">
                            @foreach (var option in statusOptions)
                            {
                                <option value="@option"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="fw-bold"></label>
                        <input asp-for="Remarks" class="form-control" />
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReminderDate" class="fw-bold"></label>
                        <input asp-for="ReminderDate" type="date" class="form-control" />
                        <span asp-validation-for="ReminderDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReminderPlace" class="fw-bold"></label>
                        <input asp-for="ReminderPlace" class="form-control" />
                        <span asp-validation-for="ReminderPlace" class="text-danger"></span>
                    </div>

                    <!-- File Upload Field -->
                    <div class="mb-3">
                        <label class="fw-bold">Upload File</label>
                        <input type="file" name="File" class="form-control" />
                    </div>

                    <!-- Show Existing File Link if Available -->
                    @if (!string.IsNullOrEmpty(Model.FilePath))
                    {
                        <div class="mb-3">
                            <label class="fw-bold">Current File</label>
                            <a href="@Url.Content(Model.FilePath)" target="_blank" class="btn btn-sm btn-outline-primary" title="Click to view">
                                <i class="bi bi-file-earmark-text"></i> View File
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Buttons Row -->
            <div class="row mt-3">
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                    <input type="submit" value="Save Changes" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
