@model IEnumerable<KLENZ.Models.CompanyName>

@{
    ViewData["Title"] = "Companies";
}

<div class="page-head">
    <div class="page-title">
        <span class="page-icon"><i class="bi bi-building"></i></span>
        <div>
            <h1>Companies</h1>
            <p class="page-sub" data-count></p>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary" data-primary-action><i class="bi bi-plus-lg"></i><span>New company</span></a>
    </div>
</div>

<div class="card list-card">
    <div class="table-responsive">
        <table class="table datatable align-middle">
            <thead>
                    <tr>
                        <th class="action-column">Actions</th>
                        <th>Full Name</th>
                        <th>Short Name</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="action-column">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                        <i class="bi bi-trash text-danger fs-5"></i>
                                    </a>
                                </div>
                            </td>
                            <td>@item.FullName</td>
                            <td><strong class="text-dark">@item.ShortName</strong></td>
                            <td>
                                @if (item.IsActive == 1)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1 text-success"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</div>
