@using KLENZ.Controllers
@model IEnumerable<PositiveEnquiry>

@{
    ViewData["Title"] = "Positive enquiries";
}

<script src="~/js/Pdf_Excel_Export.js" asp-append-version="true"></script>



<div class="page-head">
    <div class="page-title">
        <span class="page-icon"><i class="bi bi-list-ul"></i></span>
        <div>
            <h1>Positive enquiries</h1>
            <p class="page-sub" data-count></p>
        </div>
    </div>
    <div class="page-actions">
        <button type="button" id="exportExcel_PositiveEnquiry" class="btn" title="Export to Excel"><i class="bi bi-file-earmark-spreadsheet"></i><span>Excel</span></button>
        <button type="button" id="exportPdf_PositiveEnquiry" class="btn" title="Export to PDF"><i class="bi bi-file-earmark-pdf"></i><span>PDF</span></button>
        <a asp-action="Create" class="btn btn-primary" data-primary-action><i class="bi bi-plus-lg"></i><span>New positive enquiry</span></a>
    </div>
</div>

<div class="card list-card">
    <div class="table-responsive">
        <table class="table datatable align-middle">
            <thead>
                    <tr>
                        <th class="action-column">Actions</th>
                        <th>Quotation Date</th>
                        <th>Company Name</th>
                        <th>Product Details</th>
                        <th>Customer Details</th>
                        <th>Quotation Value</th>
                        <th class="text-center">Current Status</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="action-column">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                        <i class="bi bi-trash text-danger fs-5"></i>
                                    </a>
                                </div>
                            </td>
                            <td>@item.QuotationDate?.ToString("dd/MM/yyyy")</td>
                            <td><strong class="text-dark">@(item.Company?.ShortName ?? "N/A")</strong></td>
                            <td>@item.ProductDetails</td>
                            <td>@item.CustomerDetails</td>
                            <td>@(item.QuotationValue.HasValue ? item.QuotationValue.Value.ToString("C") : "N/A")</td>
                            <td class="text-center">
                                @if (item.CurrentStatus == "Pending")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">Pending</span>
                                }
                                else if (item.CurrentStatus == "Approved")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">Approved</span>
                                }
                                else if (item.CurrentStatus == "Rejected")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">@(item.CurrentStatus ?? "N/A")</span>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</div>
