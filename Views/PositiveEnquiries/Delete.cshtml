@using KLENZ.Controllers
@model PositiveEnquiry

@{
    ViewData["Title"] = "Delete positive enquiry";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to positive enquiries</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Delete positive enquiry</h1>
        </div>
    </div>
</div>

<div class="card detail-card">
    <div class="card-body">
        <p class="notice notice-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Are you sure you want to delete this record?</p>

        <!-- Bootstrap Grid for Displaying Fields -->
        <dl class="facts">
            <div class="fact"><dt>Quotation Date</dt><dd>@Model.QuotationDate?.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>Company Name</dt><dd>@Html.DisplayFor(model => model.CompanyNameStr)</dd></div>

            <div class="fact"><dt>Product Details</dt><dd>@Html.DisplayFor(model => model.ProductDetails)</dd></div>

            <div class="fact"><dt>Customer Details</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt>Quotation Value</dt><dd>@Html.DisplayFor(model => model.QuotationValue)</dd></div>

            <div class="fact"><dt>Current Status</dt><dd>@Html.DisplayFor(model => model.CurrentStatus)</dd></div>

            <div class="fact"><dt>Created Date</dt><dd>@Model.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</dd></div>

            <div class="fact"><dt>Created User</dt><dd>@Html.DisplayFor(model => model.CreatedUserId)</dd></div>
        </dl>

        <!-- Buttons with proper spacing -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-cols">
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </div>
            </div>
        </form>
    </div>
</div>
