@model KLENZ.Models.DashboardViewModel

@{
    ViewData["Title"] = "Overview";
    var attention = Model.Overdue.Count + Model.DueToday.Count;
    var firstTab = Model.Overdue.Count > 0 && Model.DueToday.Count == 0 ? "over" : "today";
    var stages = new (string Name, int Count)[]
    {
        ("Enquiries", Model.Enquiries), ("Quotations", Model.Quotations), ("Positive", Model.Positive), ("Projects", Model.Projects)
    };
    var topStage = Math.Max(1, stages.Max(s => s.Count));
    var funnel = stages.Select((s, i) => new
    {
        s.Name,
        s.Count,
        Share = (s.Count / (double)topStage).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture),
        Step = i + 1 < stages.Length ? StepText(s.Count, stages[i + 1].Count) : ""
    }).ToList();
}

@functions {
    // Indian number style: lakh and crore
    static string Inr(decimal value)
    {
        var abs = Math.Abs(value);
        if (abs >= 10000000m) { return "₹" + (value / 10000000m).ToString("0.##") + " Cr"; }
        if (abs >= 100000m) { return "₹" + (value / 100000m).ToString("0.##") + " L"; }
        return "₹" + value.ToString("N0");
    }

    static string Rate(int part, int whole)
    {
        return whole <= 0 ? "0%" : Math.Round(part * 100.0 / whole) + "%";
    }

    static string StepText(int count, int next)
    {
        if (count <= 0) { return "No data yet"; }
        if (next > count) { return "More recorded at the next stage"; }
        return Math.Round(next * 100.0 / count) + "% move forward";
    }
}

<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Overview</h1>
            @if (Model.HasFinancialYear)
            {
                <p class="page-sub">Financial year @Model.FinancialYear, @Model.StartDate.ToString("d MMM yyyy") to @Model.EndDate.ToString("d MMM yyyy")</p>
            }
        </div>
    </div>
    <div class="page-actions">
        <a asp-controller="QuotationReports" asp-action="Create" class="btn"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i><span>New quotation</span></a>
        <a asp-controller="SalesEnquiries" asp-action="Create" class="btn btn-primary" data-primary-action><i class="bi bi-plus-lg" aria-hidden="true"></i><span>New enquiry</span></a>
    </div>
</div>

@if (!Model.HasFinancialYear)
{
    <div class="notice" role="status">
        <i class="bi bi-calendar2-range" aria-hidden="true"></i>
        <div>
            <strong>No active financial year</strong>
            <p>Mark a financial year as active to see numbers here. <a asp-controller="FinancialYears" asp-action="Index">Open financial years</a></p>
        </div>
    </div>
}
else
{
    <section class="stats" aria-label="This financial year">
        <a class="stat" asp-controller="SalesEnquiries" asp-action="Index">
            <span class="stat-label">Enquiries</span>
            <span class="stat-value">@Model.Enquiries</span>
            <span class="stat-note @(attention > 0 ? "warn" : "")">@(attention == 0 ? "No follow-ups due" : attention + (attention == 1 ? " follow-up needs attention" : " follow-ups need attention"))</span>
        </a>
        <a class="stat" asp-controller="QuotationReports" asp-action="Index">
            <span class="stat-label">Quoted value</span>
            <span class="stat-value">@Inr(Model.QuotedValue)</span>
            <span class="stat-note">@Model.Quotations @(Model.Quotations == 1 ? "quotation" : "quotations")</span>
        </a>
        <a class="stat" asp-controller="ProjectLists" asp-action="Index">
            <span class="stat-label">Work orders</span>
            <span class="stat-value">@Inr(Model.WonValue)</span>
            <span class="stat-note">@Model.Projects @(Model.Projects == 1 ? "project" : "projects"), @Rate(Model.Projects, Model.Enquiries) of enquiries</span>
        </a>
        <a class="stat" asp-controller="ProjectTenderList" asp-action="Index">
            <span class="stat-label">Tenders</span>
            <span class="stat-value">@Model.Tenders</span>
            <span class="stat-note">@Model.UpcomingTenders to be tendered, @Model.Consultancy consultancy</span>
        </a>
    </section>

    <div class="dash">
        <section class="card panel queue g7" aria-labelledby="attTitle">
            <div class="card-head"><h2 id="attTitle">Follow-ups</h2><div class="sp"><a class="link" asp-controller="SalesEnquiries" asp-action="Index">All enquiries</a></div></div>
            <div class="tabs" id="attTabs" role="tablist">
                <button type="button" role="tab" class="warn @(firstTab == "over" ? "on" : "")" aria-selected="@(firstTab == "over" ? "true" : "false")" data-tab="over">Overdue<b>@Model.Overdue.Count</b></button>
                <button type="button" role="tab" class="@(firstTab == "today" ? "on" : "")" aria-selected="@(firstTab == "today" ? "true" : "false")" data-tab="today">Today<b>@Model.DueToday.Count</b></button>
                <button type="button" role="tab" aria-selected="false" data-tab="soon">Next 7 days<b>@Model.Upcoming.Count</b></button>
            </div>

            <div class="rows" role="tabpanel" data-panel="over" hidden="@(firstTab != "over")">
                @foreach (var r in Model.Overdue)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when over">@r.Date.ToString("dd MMM")</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Details</small></div>
                        <span class="where">@r.Place</span>
                        <i class="bi bi-chevron-right go" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Overdue.Count == 0)
                {
                    <div class="empty"><i class="bi bi-check2-circle" aria-hidden="true"></i>Nothing overdue.</div>
                }
            </div>
            <div class="rows" role="tabpanel" data-panel="today" hidden="@(firstTab != "today")">
                @foreach (var r in Model.DueToday)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when today">Today</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Details</small></div>
                        <span class="where">@r.Place</span>
                        <i class="bi bi-chevron-right go" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.DueToday.Count == 0)
                {
                    <div class="empty"><i class="bi bi-check2-circle" aria-hidden="true"></i>No follow-ups due today.</div>
                }
            </div>
            <div class="rows" role="tabpanel" data-panel="soon" hidden>
                @foreach (var r in Model.Upcoming)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@r.Id">
                        <span class="when">@r.Date.ToString("ddd dd")</span>
                        <div class="t"><strong>@r.Company</strong><small>@r.Details</small></div>
                        <span class="where">@r.Place</span>
                        <i class="bi bi-chevron-right go" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Upcoming.Count == 0)
                {
                    <div class="empty"><i class="bi bi-calendar3" aria-hidden="true"></i>Nothing scheduled for the next 7 days.</div>
                }
            </div>
        </section>

        <section class="card panel g5" aria-labelledby="funnelTitle">
            <div class="card-head"><h2 id="funnelTitle">Sales funnel</h2><small>This financial year</small></div>
            <ol class="funnel" id="funnel">
                @foreach (var f in funnel)
                {
                    <li class="fr">
                        <span class="fr-name">@f.Name</span>
                        <span class="ft" aria-hidden="true"><span class="ff" style="--w: @f.Share"></span></span>
                        <span class="n num">@f.Count</span>
                        @if (f.Step != "")
                        {
                            <span class="fc">@f.Step</span>
                        }
                    </li>
                }
            </ol>
        </section>

        <section class="card panel g7" aria-labelledby="chartTitle">
            <div class="card-head">
                <h2 id="chartTitle">Quoted and won by month</h2><small>Rupees in lakh</small>
                <div class="sp legend"><span><i class="key key-quoted" aria-hidden="true"></i>Quoted</span><span><i class="key key-won" aria-hidden="true"></i>Won</span></div>
            </div>
            <div class="chart" id="chart"></div>
        </section>

        <section class="card panel g5" aria-labelledby="recentTitle">
            <div class="card-head"><h2 id="recentTitle">Recent enquiries</h2><div class="sp"><a class="link" asp-controller="SalesEnquiries" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var e in Model.RecentEnquiries)
                {
                    <a asp-controller="SalesEnquiries" asp-action="Details" asp-route-id="@e.Id">
                        <div class="t"><strong>@e.Title</strong><small>@e.Subtitle</small></div>
                        @if (e.Status != "")
                        {
                            <span class="pill pill-gray" data-status-pill>@e.Status</span>
                        }
                        <span class="when">@(e.Date.HasValue ? e.Date.Value.ToString("dd MMM") : "No date")</span>
                    </a>
                }
                @if (Model.RecentEnquiries.Count == 0)
                {
                    <div class="empty"><i class="bi bi-chat-left-text" aria-hidden="true"></i>No enquiries yet this year. Add the first one.</div>
                }
            </div>
        </section>

        <section class="card panel g6" aria-labelledby="projTitle">
            <div class="card-head"><h2 id="projTitle">Latest work orders</h2><div class="sp"><a class="link" asp-controller="ProjectLists" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var p in Model.RecentProjects)
                {
                    <a asp-controller="ProjectLists" asp-action="Details" asp-route-id="@p.Id">
                        <div class="t"><strong>@p.Title</strong><small>@p.Subtitle</small></div>
                        <span class="amt num">@(p.Amount.HasValue ? Inr(p.Amount.Value) : "")</span>
                    </a>
                }
                @if (Model.RecentProjects.Count == 0)
                {
                    <div class="empty"><i class="bi bi-clipboard-check" aria-hidden="true"></i>No work orders logged yet.</div>
                }
            </div>
        </section>

        <section class="card panel g6" aria-labelledby="tenderTitle">
            <div class="card-head"><h2 id="tenderTitle">Latest tenders</h2><div class="sp"><a class="link" asp-controller="ProjectTenderList" asp-action="Index">View all</a></div></div>
            <div class="rows">
                @foreach (var t in Model.RecentTenders)
                {
                    <a asp-controller="ProjectTenderList" asp-action="Details" asp-route-id="@t.Id">
                        <div class="t"><strong>@t.Title</strong><small>@t.Subtitle</small></div>
                        <span class="amt num">@(t.Amount.HasValue ? Inr(t.Amount.Value) : "")</span>
                    </a>
                }
                @if (Model.RecentTenders.Count == 0)
                {
                    <div class="empty"><i class="bi bi-file-ruled" aria-hidden="true"></i>No tenders logged yet.</div>
                }
            </div>
        </section>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var months = @Html.Raw(Json.Serialize(Model.Months));

            // Follow-up tabs
            var tabs = document.getElementById('attTabs');
            if (tabs) {
                tabs.addEventListener('click', function (e) {
                    var b = e.target.closest('button');
                    if (!b) { return; }
                    tabs.querySelectorAll('button').forEach(function (x) {
                        x.classList.toggle('on', x === b);
                        x.setAttribute('aria-selected', x === b ? 'true' : 'false');
                    });
                    document.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== b.getAttribute('data-tab'); });
                });
            }

            // Status colours on recent enquiries
            document.querySelectorAll('[data-status-pill]').forEach(function (p) {
                var t = p.textContent.toLowerCase(), tone = 'gray';
                if (/positive|won|approved|confirm|complete|order/.test(t)) { tone = 'green'; }
                else if (/lost|reject|cancel|closed|dropped/.test(t)) { tone = 'red'; }
                else if (/follow|pending|wait|hold|progress/.test(t)) { tone = 'amber'; }
                else if (/quot|sent|submitted|offer/.test(t)) { tone = 'violet'; }
                else if (/new|open|enquir|received/.test(t)) { tone = 'blue'; }
                p.className = 'pill pill-' + tone;
            });

            // Quoted and won by month
            var chart = document.getElementById('chart');
            if (chart) {
                if (!months.length || !months.some(function (m) { return m.quoted > 0 || m.won > 0; })) {
                    chart.innerHTML = '<div class="empty"><i class="bi bi-bar-chart-line" aria-hidden="true"></i>No quotations or work orders with dates yet this year.</div>';
                    return;
                }
                var lakh = function (v) { return v / 100000; };
                var peak = Math.max.apply(null, months.map(function (m) { return Math.max(lakh(m.quoted), lakh(m.won)); }));
                var pow = Math.pow(10, Math.floor(Math.log10(peak || 1))), max = Math.ceil(peak / pow) * pow || 1;
                if (max / pow <= 2) { max = Math.ceil(peak / (pow / 2)) * (pow / 2); }
                var H = 190, L = 42, W = 560, bw = (W - L) / months.length, bar = Math.min(16, bw / 2 - 3);
                var fmt = function (v) { return v >= 100 ? Math.round(v) : Math.round(v * 10) / 10; };
                var svg = '<svg viewBox="0 0 ' + W + ' ' + (H + 26) + '" role="img" aria-label="Quoted and won value by month, in lakh rupees">';
                [0, 0.25, 0.5, 0.75, 1].forEach(function (f) {
                    var y = H - f * (H - 10);
                    svg += '<line class="grid-line" x1="' + L + '" x2="' + W + '" y1="' + y + '" y2="' + y + '" stroke-width="1"/>' +
                        '<text class="axis" x="' + (L - 8) + '" y="' + (y + 4) + '" text-anchor="end">' + fmt(max * f) + '</text>';
                });
                months.forEach(function (m) {
                    var i = months.indexOf(m), x = L + i * bw + bw / 2, hq = lakh(m.quoted) / max * (H - 10), hw = lakh(m.won) / max * (H - 10);
                    svg += '<rect class="bar-quoted" x="' + (x - bar - 1) + '" y="' + (H - hq) + '" width="' + bar + '" height="' + hq + '" rx="3"><title>' + m.label + ': quoted ₹' + fmt(lakh(m.quoted)) + ' L</title></rect>' +
                        '<rect class="bar-won" x="' + (x + 1) + '" y="' + (H - hw) + '" width="' + bar + '" height="' + hw + '" rx="3"><title>' + m.label + ': won ₹' + fmt(lakh(m.won)) + ' L</title></rect>' +
                        '<text class="axis" x="' + x + '" y="' + (H + 18) + '" text-anchor="middle">' + m.label + '</text>';
                });
                chart.innerHTML = svg + '</svg>';
            }
        })();
    </script>
}
