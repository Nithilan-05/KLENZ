@model IEnumerable<KLENZ.Models.SalesEnquiry>

@{
    ViewData["Title"] = "Enquiries";
}

<div class="page-head">
    <div class="page-title">
        <span class="page-icon"><i class="bi bi-bar-chart"></i></span>
        <div>
            <h1>Enquiries</h1>
            <p class="page-sub" data-count></p>
        </div>
    </div>
    <div class="page-actions">
        <button type="button" id="exportExcel" class="btn" title="Export to Excel"><i class="bi bi-file-earmark-spreadsheet"></i><span>Excel</span></button>
        <button type="button" id="exportPdf" class="btn" title="Export to PDF"><i class="bi bi-file-earmark-pdf"></i><span>PDF</span></button>
        <a asp-action="Create" class="btn btn-primary" data-primary-action><i class="bi bi-plus-lg"></i><span>New enquiry</span></a>
    </div>
</div>

<div class="card list-card">
    <div class="table-responsive">
        <table class="table datatable align-middle">
            <thead>
                    <tr>
                        <th class="action-column">Actions</th>
                        <th>Enquiry Date</th>
                        <th>Company Name</th>
                        <th>Enquiry Details</th>
                        <th>Customer Details</th>
                        <th>Status</th>
                        <th>Reminder Date</th>
                        <th>Reminder Place</th>
                        <th class="text-center">Attachment</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="action-column">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                        <i class="bi bi-trash text-danger fs-5"></i>
                                    </a>
                                </div>
                            </td>
                            <td>@item.EnquiryDate?.ToString("dd/MM/yyyy")</td>
                            <td><strong class="text-dark">@(item.Company?.ShortName ?? "N/A")</strong></td>
                            <td>@Html.DisplayFor(modelItem => item.EnquiryDetails)</td>
                            <td>@Html.DisplayFor(modelItem => item.CustomerDetails)</td>
                            <td>@Html.DisplayFor(modelItem => item.Status)</td>
                            <td>@item.ReminderDate?.ToString("dd/MM/yyyy")</td>
                            <td>@Html.DisplayFor(modelItem => item.ReminderPlace)</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a href="@Url.Content(item.FilePath)" target="_blank" class="text-primary fs-5" title="Click to View">
                                        <i class="bi bi-cloud-arrow-down-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">No File</span>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</div>
<script src="~/js/Pdf_Excel_Export.js" asp-append-version="true"></script>