@model KLENZ.Models.QuotationReport

@{
    ViewData["Title"] = "Delete quotation";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to quotations</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Delete quotation</h1>
        </div>
    </div>
</div>

<div class="card detail-card">

    <div class="card-body">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Warning:</strong> Are you sure you want to delete this quotation report? This action cannot be undone.
        </div>

        <dl class="facts">
            <div class="fact"><dt><i class="bi bi-calendar"></i> @Html.DisplayNameFor(model => model.QuotationDate)</dt><dd>@Html.DisplayFor(model => model.QuotationDate)</dd></div>

            <div class="fact"><dt><i class="bi bi-buildings"></i> @Html.DisplayNameFor(model => model.CompanyNameStr)</dt><dd>@(Model.Company?.ShortName ?? "N/A")</dd></div>

            <div class="fact"><dt><i class="bi bi-card-list"></i> @Html.DisplayNameFor(model => model.ProductDetails)</dt><dd>@Html.DisplayFor(model => model.ProductDetails)</dd></div>

            <div class="fact"><dt><i class="bi bi-person"></i> @Html.DisplayNameFor(model => model.CustomerDetails)</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt><i class="bi bi-cash-stack"></i> @Html.DisplayNameFor(model => model.QuotationValue)</dt><dd>@Html.DisplayFor(model => model.QuotationValue)</dd></div>

            <div class="fact"><dt><i class="bi bi-chat-left-text"></i> @Html.DisplayNameFor(model => model.Remarks)</dt><dd>@Html.DisplayFor(model => model.Remarks)</dd></div>

            <div class="fact"><dt><i class="bi bi-check-circle"></i> @Html.DisplayNameFor(model => model.IsPositive)</dt><dd>@(Model.IsPositiveBool ? "Yes" : "No")</dd></div>

            <div class="fact"><dt><i class="bi bi-clock-history"></i> @Html.DisplayNameFor(model => model.CreatedDateTime)</dt><dd>@Html.DisplayFor(model => model.CreatedDateTime)</dd></div>

            <div class="fact"><dt><i class="bi bi-person-badge"></i> @Html.DisplayNameFor(model => model.CreatedUserId)</dt><dd>@Html.DisplayFor(model => model.CreatedUserId)</dd></div>
        </dl>
    </div>

    <div class="card-footer d-flex">
        <form asp-action="Delete" method="post" class="w-100">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
