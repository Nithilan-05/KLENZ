@model KLENZ.Models.GSTTypes

@{
    ViewData["Title"] = "Delete GST type";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i>Back to GST types</a>
<div class="page-head">
    <div class="page-title"><div><h1>Delete GST type</h1></div></div>
</div>
<div class="notice" role="alert">
    <i class="bi bi-exclamation-triangle" style="color:var(--red)"></i>
    <div><strong>Delete this record?</strong><p>It is removed permanently and cannot be recovered.</p></div>
</div>
<div class="card detail-card">
    <dl class="facts">
        <div class="fact"><dt>@Html.DisplayNameFor(model => model.GSTType)</dt><dd>@Html.DisplayFor(model => model.GSTType)</dd></div>
        <div class="fact"><dt>@Html.DisplayNameFor(model => model.CreatedDateTime)</dt><dd>@Html.DisplayFor(model => model.CreatedDateTime)</dd></div>
        <div class="fact"><dt>@Html.DisplayNameFor(model => model.CreatedUserId)</dt><dd>@Html.DisplayFor(model => model.CreatedUserId)</dd></div>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="detail-actions">
            <button type="submit" class="btn btn-danger btn-solid"><i class="bi bi-trash3"></i>Delete</button>
            <a asp-action="Index" class="btn">Cancel</a>
        </div>
    </form>
</div>
