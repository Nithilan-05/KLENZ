@model KLENZ.Models.QuotationReport

@{
    ViewData["Title"] = "Quotation details";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to quotations</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Quotation details</h1>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
    </div>
</div>

<div class="card detail-card">

    <div class="card-body">
        <dl class="facts">
            <div class="fact"><dt>Quotation Date</dt><dd>@Model.QuotationDate?.ToString("dd/MM/yyyy")</dd></div>

            <div class="fact"><dt>Company Name</dt><dd>@Html.DisplayFor(model => model.CompanyNameStr)</dd></div>

            <div class="fact"><dt>Product Details</dt><dd>@Html.DisplayFor(model => model.ProductDetails)</dd></div>

            <div class="fact"><dt>Customer Details</dt><dd>@Html.DisplayFor(model => model.CustomerDetails)</dd></div>

            <div class="fact"><dt>Quotation Value</dt><dd>@Html.DisplayFor(model => model.QuotationValue)</dd></div>

            <div class="fact"><dt>Remarks</dt><dd>@Html.DisplayFor(model => model.Remarks)</dd></div>

            <div class="fact"><dt>Is Positive</dt><dd>@(Model.IsPositiveBool ? "Yes" : "No")</dd></div>

            <div class="fact"><dt>Created Date</dt><dd>@Model.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</dd></div>

            <div class="fact"><dt>Created User</dt><dd>@Html.DisplayFor(model => model.CreatedUserName)</dd></div>
        </dl>
    </div>
</div>
