@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Edit financial year";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to financial years</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Edit financial year</h1>
        </div>
    </div>
</div>

<div class="card form-card">

    <div class="card-body">
        <form asp-action="Edit" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row align-items-center mb-3">
                <label asp-for="StartDate" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="form-col">
                    <input asp-for="StartDate" type="date" class="form-control border-warning shadow-sm" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <label asp-for="EndDate" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="form-col">
                    <input asp-for="EndDate" type="date" class="form-control border-warning shadow-sm" required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <div class="col-md-6 offset-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="IsActiveBool" name="IsActiveBool"
                               value="true" @(Model?.IsActiveBool == true ? "checked" : "") />
                        <label class="form-check-label fw-bold ms-2" for="IsActiveBool">Active (Deactivates other financial years)</label>
                    </div>
                    <span asp-validation-for="IsActiveBool" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
