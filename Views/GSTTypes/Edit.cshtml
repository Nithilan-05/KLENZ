@model KLENZ.Models.GSTTypes

@{
    ViewData["Title"] = "Edit GST type";
}

<a asp-action="Index" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to GST types</a>
<div class="page-head">
    <div class="page-title">
        <div>
            <h1>Edit GST type</h1>
        </div>
    </div>
</div>

<div class="card form-card">

    <div class="card-body">
        <form asp-action="Edit" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDateTime" />
            <input type="hidden" asp-for="CreatedUserId" />

            <div class="row align-items-center mb-3">
                <label asp-for="GSTType" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="form-col">
                    <div class="input-group">
                        <input asp-for="GSTType" class="form-control border-warning shadow-sm" placeholder="Enter GST Rate" required />
                        <span class="input-group-text bg-warning text-white">%</span>
                    </div>
                    <span asp-validation-for="GSTType" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
